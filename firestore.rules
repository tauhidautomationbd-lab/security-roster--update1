rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This allows any anonymously signed-in user to read/write the roster data
    // This is appropriate for a company roster where anyone with the link can edit.
    match /shared_roster/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
